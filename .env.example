# Where the GraphQL api runs (mgpl-diagnostics/api). The app forwards /graphql there.
MGPL_API_URL=http://localhost:4000
# Optional. Leave empty: the api finds the lab from the account, and the sign-in form asks for a
# code only when one email belongs to several labs. Set it to send this lab code on every sign-in.
NEXT_PUBLIC_MGPL_ORG_CODE=
# Optional. The api address the BROWSER uses, e.g. https://api.example.in:8443/graphql. Empty: the browser
# calls /graphql on this app and the server forwards it to MGPL_API_URL. Set it when the api's own TLS proxy
# must see the browser's connection (JA4 fingerprint, client IP); add this app's origin to the api's
# CORS_ORIGINS. Read when the server runs, so the published image works with any address.
MGPL_PUBLIC_API_URL=
